# Copy to .env.local for local dev (it is gitignored).
#
# On Railway set these as SERVICE VARIABLES instead — and use AI_API_KEY there,
# never VITE_AI_API_KEY: every VITE_ value is inlined into the public JS bundle,
# while AI_API_KEY stays on the server (server.js proxies /api/ai).

# ── local dev / direct browser calls ──
VITE_AI_API_KEY=
VITE_AI_PROVIDER=cline
# VITE_AI_MODEL_CHAT=nvidia/nemotron-3-ultra-550b-a55b:free
# VITE_AI_MODEL_VISION=google/gemini-3.8-flash
# VITE_AI_MODEL_PLAN=anthropic/claude-sonnet-5.5
# VITE_AI_PROXY=off

# ── server (Railway) ──
AI_API_KEY=
AI_BASE_URL=https://api.cline.bot/api/v1
# AI_MODEL_CHAT=cline-pass/glm-5.3-flash
# AI_MODEL_VISION=google/gemini-3.8-flash
# AI_MODEL_PLAN=cline-pass/kimi-k3
